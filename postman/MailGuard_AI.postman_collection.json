        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderEmail\": \"friend@gmail.com\",\n  \"subject\": \"Lunch tomorrow?\",\n  \"body\": \"Hey, are we meeting for lunch tomorrow at 1 pm?\"\n}",
