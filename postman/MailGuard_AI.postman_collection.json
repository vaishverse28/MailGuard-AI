          "raw": "{{baseUrl}}/api/emails/history?status=PHISHING&search=verify&sort=risk_desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "emails",
            "history"
          ],
          "query": [
            {
              "key": "status",
              "value": "PHISHING"
            },
            {
              "key": "search",
              "value": "verify"
            },
